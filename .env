# Base URL of the FastAPI backend. Never hardcode this in source files.
VITE_API_BASE_URL=http://localhost:8000/api

# When true, all API services return realistic mock data instead of calling
# the backend. Flip to false once the FastAPI backend is running.
VITE_USE_MOCK_API=true

# Simulated network latency (ms) for mock API responses, so loading states
# are visible during development. Ignored when VITE_USE_MOCK_API=false.
VITE_MOCK_LATENCY_MS=500

# Map tile provider key, only needed if you swap the default OSM tiles for
# a provider that requires a key (Mapbox, MapTiler, etc). Left blank uses
# free OpenStreetMap tiles.
VITE_MAP_TILES_API_KEY=

# City map default center (Nagpur) and zoom, kept configurable rather than
# hardcoded inside the map component.
VITE_MAP_DEFAULT_LAT=21.1458
VITE_MAP_DEFAULT_LNG=79.0882
VITE_MAP_DEFAULT_ZOOM=12
